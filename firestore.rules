rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Check whether request has authenticated Firebase user
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: Strict Administrator UID Verification
    // Authorized Admin UID: kAyEZzqc3PPPVLE53awnCvg4wD62
    function isAdmin() {
      return isAuthenticated() && request.auth.uid == 'kAyEZzqc3PPPVLE53awnCvg4wD62';
    }

    // Visitor Entries Collection
    match /visitorEntries/{entryId} {
      // 1. PUBLIC CREATE:
      // Validated, consented entries only.
      // - Must contain all required fields: name, consent, createdAt using hasAll()
      // - No additional fields allowed using hasOnly()
      // - Name must be a string with length 1 to 40
      // - Name must equal its trimmed version (no leading/trailing whitespace, no whitespace-only)
      // - Explicit consent must be true
      // - createdAt must strictly equal request.time (serverTimestamp only)
      allow create: if request.resource.data.keys().hasAll(['name', 'consent', 'createdAt'])
                    && request.resource.data.keys().hasOnly(['name', 'consent', 'createdAt'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() >= 1
                    && request.resource.data.name.size() <= 40
                    && request.resource.data.name.matches('^\\S(.*\\S)?$')
                    && request.resource.data.consent == true
                    && request.resource.data.createdAt == request.time;

      // 2. READ:
      // Public cannot read.
      // Individual document GET: strictly authorized Admin UID only.
      allow get: if isAdmin();

      // Collection LIST: strictly authorized Admin UID only AND query limit <= 50.
      // Queries without a limit or with limit > 50 are strictly denied.
      allow list: if isAdmin() && request.query.limit != null && request.query.limit <= 50;

      // 3. DELETE:
      // ONLY the authorized Admin UID can delete records.
      allow delete: if isAdmin();

      // 4. IMMUTABLE:
      // Nobody can modify or update existing records.
      allow update: if false;
    }

    // Default deny for all other collections and documents
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
