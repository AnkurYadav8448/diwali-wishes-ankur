VITE_FIREBASE_MESSAGING_SENDER_ID=776575298445
VITE_FIREBASE_APP_ID=1:776575298445:web:438c91dafa6acaf2946bc4

# ==============================================================================
# ADMIN AUTHORIZATION SECURITY
# ==============================================================================
# The specific Firebase User UID authorized to access the Admin Dashboard.
# Leave empty initially. After first Google Sign-In, copy the UID shown
# in the Admin Portal and paste it here.
VITE_ADMIN_UID=
